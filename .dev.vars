# Local overrides for `npx wrangler dev`: read the timetable from the Node dev server
# (`npm run dev`) instead of GitHub Pages. No secrets belong in this file.
PAGES_URL=http://localhost:8787
# workerd (local only) can't connect to BCT's server, which offers only older TLS cipher suites;
# the deployed Worker can. Locally, fetch BCT's feeds through the Node dev server instead.
# That relay includes the contracted routes' buses when the Node server has CONTRACT_FEED_BASE.
BCT_BASE=http://localhost:8787/dev/bct/
